{
  "name": "edtech-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the EdTech CRM & Inquiry System (custom JWT auth, Supabase Postgres via pg).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "db:local": "node scripts/local-db.js",
    "test": "node --test --test-force-exit --test-reporter=spec test/api.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1"
  }
}
