# ---------------------------------------------------------------------------
# Environment variables for the BACKEND. Copy this file to backend/.env and fill it in.
# (The frontend needs no secrets; see frontend/.env.example for the optional demo-login hint.)
# ---------------------------------------------------------------------------

# Supabase Postgres connection string.
# Supabase dashboard -> your project -> "Connect" (top bar) -> "Transaction pooler" -> copy the URI,
# then replace [YOUR-PASSWORD] with your database password.
# Use the transaction pooler (port 6543) for serverless hosting like Vercel; the session pooler
# (port 5432) also works for a normal long-running server.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Secret used to sign the admin JWTs (HS256). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# How long an admin stays logged in (jsonwebtoken format: 15m, 8h, 1d ...).
JWT_EXPIRES_IN=8h

# Port for local development (ignored on Vercel).
PORT=4000

# Only needed if a browser on ANOTHER domain calls the API directly (comma-separated).
# Leave empty when the frontend proxies /api (the default setup in this repo).
CORS_ORIGINS=

# Used by `npm run db:create-admin` when you run it without arguments.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Admissions Desk
